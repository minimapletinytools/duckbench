{
  "name": "duckbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "uv run python -m unittest discover -s tests",
    "test:browser": "node tests/browser.mjs",
    "package": "uv run python scripts/prepare-runtime.py && npm run build && electron-builder --dir",
    "test:desktop": "node tests/desktop.mjs",
    "credits": "uv run python scripts/generate-credits.py",
    "prebuild": "npm run credits",
    "predev": "npm run credits",
    "icons": "node scripts/capture-icon.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "monaco-editor": "^0.57.0",
    "three-cad-viewer": "5.1.3"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "dev.build1234.viewer",
    "files": [
      "dist/**",
      "electron/**",
      "python/**",
      "pyproject.toml",
      "uv.lock",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "python/**"
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "icon": "public/icons/duck.icns"
    },
    "directories": {
      "output": "release/app"
    },
    "extraResources": [
      {
        "from": "release/python",
        "to": "python"
      }
    ],
    "productName": "Duckbench",
    "icon": "public/icons/duck-512.png",
    "win": {
      "icon": "public/icons/duck.ico"
    },
    "linux": {
      "icon": "public/icons/duck-512.png"
    }
  },
  "description": "Standalone build123d desktop and browser workbench",
  "overrides": {
    "dompurify": "3.4.17"
  },
  "license": "Apache-2.0"
}
